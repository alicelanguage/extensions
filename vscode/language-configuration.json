{
  "comments": {
    "lineComment": "#"
  },
  "brackets": [
    [
      "(",
      ")"
    ],
    [
      "[",
      "]"
    ],
    [
      "{",
      "}"
    ]
  ],
  "autoClosingPairs": [
    {
      "open": "(",
      "close": ")",
      "notIn": [
        "string",
        "comment"
      ]
    },
    {
      "open": "[",
      "close": "]",
      "notIn": [
        "string",
        "comment"
      ]
    },
    {
      "open": "{",
      "close": "}",
      "notIn": [
        "string",
        "comment"
      ]
    },
    {
      "open": "\"",
      "close": "\"",
      "notIn": [
        "string",
        "comment"
      ]
    },
    {
      "open": "'",
      "close": "'",
      "notIn": [
        "string",
        "comment"
      ]
    }
  ],
  "surroundingPairs": [
    [
      "(",
      ")"
    ],
    [
      "[",
      "]"
    ],
    [
      "{",
      "}"
    ],
    [
      "\"",
      "\""
    ]
  ],
  "wordPattern": "@?[a-zA-Z_][a-zA-Z_0-9]*[?!]?",
  "indentationRules": {
    "increaseIndentPattern": "^\\s*(?:unchecked\\s*$|(?:par\\s+)?(?:def|class|struct|module|interface|enum|lib|namespace|if|unless|while|until|for|case|begin)\\b(?!.*\\bend\\b)(?!.*=)|.*\\bdo(?:\\s*\\|[^|]*\\|)?\\s*$)",
    "decreaseIndentPattern": "^\\s*(?:end|else|elsif|when|rescue|ensure)\\b"
  },
  "folding": {
    "markers": {
      "start": "^\\s*#\\s*region\\b",
      "end": "^\\s*#\\s*endregion\\b"
    }
  }
}
