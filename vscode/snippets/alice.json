{
  "Method": {
    "prefix": "def",
    "body": [
      "def ${1:name}(${2:args})${3: : Int32}",
      "  $0",
      "end"
    ],
    "description": "Define a method"
  },
  "Class": {
    "prefix": "class",
    "body": [
      "class ${1:Name}",
      "  $0",
      "end"
    ],
    "description": "Define a class"
  },
  "Module": {
    "prefix": "module",
    "body": [
      "module ${1:Name}",
      "  $0",
      "end"
    ]
  },
  "For loop": {
    "prefix": "for",
    "body": [
      "for ${1:item} in ${2:items}",
      "  $0",
      "end"
    ]
  },
  "Conditional": {
    "prefix": "if",
    "body": [
      "if ${1:condition}",
      "  $0",
      "end"
    ]
  },
  "Spec": {
    "prefix": "describe",
    "body": [
      "describe \"${1:feature}\" do",
      "  it \"${2:works}\" do",
      "    $0",
      "  end",
      "end"
    ]
  },
  "Using namespace": {
    "prefix": "using",
    "body": "using ${1:System.Diagnostics}"
  },
  "Immutable binding": {
    "prefix": "val",
    "body": "val ${1:name} = $0"
  },
  "Owned buffer": {
    "prefix": "own",
    "body": "own ${1:buffer} = Array(${2:Float64}).new(${3:n})"
  },
  "Parallel loop": {
    "prefix": "par",
    "body": [
      "par for ${1:i} in ${2:0}...${3:n}",
      "  $0",
      "end"
    ]
  },
  "Wrapping arithmetic": {
    "prefix": "unchecked",
    "body": [
      "unchecked",
      "  $0",
      "end"
    ]
  },
  "Concurrent block": {
    "prefix": "spawn",
    "body": [
      "spawn do",
      "  $0",
      "end"
    ]
  }
}
